# =====================================================================
# Product Radar API — environment variables (all RUNTIME unless noted)
# Copy to apps/api/.env for local runs. In Coolify paste into the API app's
# "Environment Variables" (Developer view). Never commit real values.
# =====================================================================

# ---- Core / security (required) ----
SECRET_KEY=replace-with-64-random-hex-chars
CORS_ORIGINS=https://projectradar.maktechgroup.com
COOKIE_SECURE=1
PROXY_COUNT=1

# ---- Seeded dashboard admin (required) ----
ADMIN_EMAIL=admin@maktechgroup.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars
ADMIN_NAME=MAKTech Admin
ADMIN_SYNC_PASSWORD=1
# Optional extra admins by email (accounts must sign up first)
ADMIN_EMAILS=

# ---- Live data sources (optional; each key switches one source on) ----
SERPAPI_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=
YOUTUBE_API_KEY=
DARAZ_ENABLED=1

# ---- AI assistant (optional; any OpenAI-compatible API) ----
#   OpenAI:     https://api.openai.com/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PRICE_IN=0
AI_PRICE_OUT=0

# ---- Data refresh & caching ----
TRENDING_COUNTRIES=BD
TRENDING_TOP=12
AUTO_REFRESH=1
REFRESH_HOURS=24
IMAGE_REFRESH_LIMIT=60
CACHE_HOURS=12

# ---- Server tuning (optional) ----
GUNICORN_THREADS=16
GUNICORN_TIMEOUT=120
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
SESSION_DAYS=30
LOG_LEVEL=info

# ---- Local development only (leave unset in Coolify; the Dockerfile sets DATA_DIR=/data) ----
# CORS_ORIGINS=http://localhost:3000
# COOKIE_SECURE=0
# PROXY_COUNT=0
# DATA_DIR=./data
