# =====================================================================
# Product Radar web — environment variables (RUNTIME; read at container start)
# Nothing is needed at build time. Changing API_URL only needs a restart, not a rebuild.
# =====================================================================
API_URL=https://api-pradar.maktechgroup.com

# Optional: extra origins the browser may call (space separated), added to CSP connect-src
CSP_EXTRA_CONNECT_SRC=
